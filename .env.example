# Select one of: gec, ged, gee
MODEL_TYPE=gec

# Optional. Leave blank for the standard TartuNLP model for MODEL_TYPE.
# HF_MODEL_NAME=

# Optional. Required only if Hugging Face requires authentication for the model.
HF_TOKEN=

# full, orig, f16, f32, q2_k, q3_k_s, q3_k_m, q3_k_l, q4_0, q4_1,
# q4_k_s, q4_k_m, q5_0, q5_1, q5_k_s, q5_k_m, q6_k, q8_0
QUANTIZATION=q4_k_m

# Optional persistent locations. Use an E: drive location if C: lacks space.
# HOST_CACHE_DIR=E:\gec-ollama\cache\huggingface
# HOST_OUTPUT_DIR=E:\gec-ollama\output
